# ─────────────────────────────────────────────────────────────────────────────
# CLEVER Phase 7 — LLM judge credentials (provider-agnostic)
#
# This file is gitignored AND excluded from the Great Lakes rsync (.glc-exclude).
# NEVER commit real keys. Drop your own keys in below.
#
# The judge talks to an OpenAI-COMPATIBLE Chat Completions API, so it works with
# OpenAI, OpenRouter, Together, Groq, Fireworks, DeepInfra, a local vLLM/Ollama
# server, etc. Pick whichever provider you have keys for and set the base URL.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — your API key for the chosen provider.
JUDGE_API_KEY=

# REQUIRED — the OpenAI-compatible base URL (must end in /v1 for most providers).
#   OpenAI:      https://api.openai.com/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   Together:    https://api.together.xyz/v1
#   Groq:        https://api.groq.com/openai/v1
#   local vLLM:  http://localhost:8000/v1
JUDGE_BASE_URL=https://api.openai.com/v1

# REQUIRED — judge model id (a strong instruction-following model).
# Examples: gpt-4o-mini, openai/gpt-4o-mini (OpenRouter), meta-llama/Llama-3.3-70B-Instruct-Turbo
JUDGE_MODEL=gpt-4o-mini

# OPTIONAL tuning (sane defaults shown).
JUDGE_MAX_CONCURRENCY=8
JUDGE_TEMPERATURE=0.0
JUDGE_MAX_RETRIES=5

# ─────────────────────────────────────────────────────────────────────────────
# Rate limiting (mainly for free-tier providers such as Groq)
#
# JUDGE_RPM           — client-side requests-per-minute cap; each request start
#                       is spaced 60/JUDGE_RPM seconds apart. 0 disables pacing.
# JUDGE_MAX_TOKENS    — max completion tokens per judge call (verdicts are one
#                       word, so keep this small).
# JUDGE_DAILY_BACKOFF_S — if the provider's Retry-After exceeds this many
#                       seconds, the run aborts with DailyLimitError instead of
#                       sleeping (a long Retry-After means the DAILY quota is
#                       gone, not the per-minute one).
#
# Groq free tier: JUDGE_MAX_CONCURRENCY=2 and JUDGE_RPM=25 are conservative
# starting points. Per-model limits vary by account tier — check yours at
# console.groq.com/settings/limits before raising these.
#
# Daily caps are safe to hit: verdicts are cached on disk, so after the quota
# resets just re-run the judge and it resumes from where it stopped.
JUDGE_RPM=25
JUDGE_MAX_TOKENS=16
JUDGE_DAILY_BACKOFF_S=600
